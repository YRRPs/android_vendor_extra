    Privileged permissions that Google Play services 26.40.32 requests and that
    MindTheGapps baklava does not allowlist. Without GET_ROLE_HOLDERS, account
    token requests fail with AUTH_SECURITY_ERROR. SystemConfig merges this block
    with the MindTheGapps one. Delete this file once baklava carries these
    entries (MindTheGapps/vendor_gapps#11); cinnamonbun already does.
-->
<permissions>
    <privapp-permissions package="com.google.android.gms">
        <permission name="android.permission.GET_ROLE_HOLDERS"/>
        <permission name="android.permission.LOG_COMPAT_CHANGE"/>
        <permission name="android.permission.MANAGE_SECURE_LOCK_DEVICE"/>
        <permission name="android.permission.OBSERVE_ROLE_HOLDERS"/>
        <permission name="android.permission.READ_COMPAT_CHANGE_CONFIG"/>
    </privapp-permissions>
</permissions>
